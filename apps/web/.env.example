# Copy to .env.local and fill in from the EdgeStack outputs of the environment you are
# building for: UserPoolId, UserPoolClientId, SignInDomain.
# There is no API URL here on purpose — the API is same-origin under /api/.
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
VITE_SIGN_IN_DOMAIN=

# Only for `vite dev`, and never in a build: the deployed site the dev server hands /api/ to.
# EdgeStack's SiteUrl output. Leave it empty and calls from the dev server have nowhere to go.
DEV_API_ORIGIN=
