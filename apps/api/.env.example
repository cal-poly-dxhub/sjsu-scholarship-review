# copy to .env for local dev. .env is git-ignored.

# aws creds — point boto3 at your own sso config (never ~/.aws defaults).
# repo-relative paths work when the api runs via `pnpm dev:api`.
AWS_CONFIG_FILE=../../.aws-local/config
AWS_SHARED_CREDENTIALS_FILE=../../.aws-local/credentials
AWS_PROFILE=myisb
AWS_REGION=us-west-2

# dynamodb table names (defaults shown)
APPLICATIONS_TABLE=sjsu-applications
SCORES_TABLE=sjsu-scores
